# Copia este archivo a .env (NO se versiona) o define estas variables en tu servidor Ubuntu / systemd / Docker.

# --- Base de datos MySQL ---
DB_URL=jdbc:mysql://localhost:3306/terranova_db
DB_USER=root
DB_PASSWORD=

# --- Seguridad JWT (obligatorio, mínimo 32 caracteres aleatorios: openssl rand -base64 48) ---
JWT_SECRET=
JWT_HORAS=8
AUTH_DEV_MODE=false
APP_COOKIE_SECURE=true

# --- URLs públicas y CORS (Frontend en Vercel <-> Backend detrás de túnel HTTPS) ---
APP_BASE_URL=https://tu-tunel.ts.net
APP_FRONTEND_URL=https://tu-app.vercel.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,https://tu-app.vercel.app

# --- Inteligencia Artificial ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Correo electrónico (Gmail SMTP con contraseña de aplicación) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@terranova.local
MAIL_NOMBRE=TerraNova

# --- Servidor y reglas ---
PORT=8080
PAGO_MINUTOS_RETENCION=15
