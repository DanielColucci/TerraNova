    {
      "name": "13 Pago APROBADO (folio Pendiente_Pago propio)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtUsuario}}"
          }
        ],
        "url": {
          "raw": "{{base}}/pago/{{folio}}/procesar?titular=Huesped Prueba&numero=4242424242424242&vencimiento=12/30&cvv=123",
          "host": [
            "{{base}}"
          ],
          "path": [
            "pago",
            "{{folio}}",
            "procesar?titular=Huesped Prueba&numero=4242424242424242&vencimiento=12",
            "30&cvv=123"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', function(){ pm.response.to.have.status(200); });",
              "pm.test('aprobado', function(){ pm.expect(pm.response.json().aprobado).to.eql(true); });"
            ]
          }
        }
      ]
    },
