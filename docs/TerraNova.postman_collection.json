{
  "info": {
    "name": "TerraNova · Auth y pago",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Antes de 13/14: con el chat o la base crea reservaciones Pendiente_Pago del USUARIO y pon sus folios en las variables folio y folioRechazo."
  },
  "item": [
    {
      "name": "1 Registro (correo nuevo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/auth/register",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Huésped Prueba\",\n  \"correo\": \"{{correoNuevo}}\",\n  \"password\": \"Clave12345\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', function(){ pm.response.to.have.status(201); });",
              "var j=pm.response.json(); if(j.enlaceVerificacion){ pm.collectionVariables.set('token', j.enlaceVerificacion.split('token=')[1]); }"
            ]
          }
        }
      ]
    },
